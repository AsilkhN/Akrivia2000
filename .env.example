# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# REQUIRED. Telegram bot token from @BotFather (https://t.me/BotFather).
# Send /newbot, pick a name, copy the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# The written commentary. Set ONE of these two keys — or both, and pick with
# AI_PROVIDER. Without either, reports still send, just without commentary.
# ---------------------------------------------------------------------------

# Option A: Groq — fast, free, but answers only from training data. When no
# headline reaches the bot it will say a move has no known explanation.
# Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Gemini — can search the web, so it can explain a move no feed
# covered. Free tier available. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web search grounding. This is the whole reason to choose Gemini; turn it off
# only if you hit quota limits and want the model to answer unaided.
GEMINI_SEARCH=true

# auto    use Gemini when its key is present, otherwise Groq (default)
# groq    force Groq
# gemini  force Gemini
AI_PROVIDER=auto

# ---------------------------------------------------------------------------
# US / world prices.
#
# By default these come from Yahoo Finance, which needs no key. Yahoo
# identifies callers by IP, though, and rate-limits datacenter ranges hard: on
# many VPS hosts every request returns "429 Edge: Too Many Requests" from the
# first call onward, and no retrying helps.
#
# Set a Twelve Data key and the bot switches automatically. Free tier: 800
# requests/day, 8/minute — the whole watchlist is fetched in one batched
# request, so a daily report costs one. Key: https://twelvedata.com/pricing
# ---------------------------------------------------------------------------

TWELVEDATA_API_KEY=

# auto      use Twelve Data when a key is present, otherwise Yahoo (default)
# yahoo     force Yahoo, even with a key set
# twelvedata  force Twelve Data
PRICE_PROVIDER=auto

# ---------------------------------------------------------------------------
# Uzbek Stock Exchange (UZSE) via parse.bot — optional.
# Leave PARSEBOT_QUOTES_URL empty to run with US stocks only.
#
# This provider is METERED. The bot fetches the whole exchange once per
# trading day and answers every command from that cached copy, so normal use
# costs about 22 requests a month, plus one per /ai on a new company.
# ---------------------------------------------------------------------------

# REQUIRED for UZSE. The get_stock_quotes endpoint — the one returning
# {"data":{"quotes":[...]}}. Fetched once per trading day, ~22 requests/month.
#
# Copy the real URL from the scraper page on parse.bot. Do not guess it: the
# path differs between deployments, and a wrong one returns 404 with no
# quotes. Verify with:
#   curl -s -H "Authorization: Bearer YOUR_KEY" "YOUR_URL" | head -c 200
# and check that the response contains "quotes".
PARSEBOT_QUOTES_URL=

# Optional. Ticker → official company name ({"data":{"securities":[...]}}).
# Reference data, refreshed at most once every 30 days.
PARSEBOT_SECURITIES_URL=

# Optional but recommended: get_stock_detail. Per-company endpoint returning 20
# sessions of history, the day's price range and volume. Used only by /ai, at
# most once per company per day. Must contain a placeholder: {ticker} or
# {security_code}.  Example: https://api.parse.bot/.../ticker/{ticker}
PARSEBOT_DETAIL_URL=

# Optional: get_trade_results. The trade tape — how much money actually changed
# hands. This is what lets the scout rank moves by money rather than by
# percentage, which is the difference between a useful report and noise on a
# market this thin. Should accept a date range; use the placeholders
# {date_from} and {date_to} if the endpoint supports them.
# Example: https://api.parse.bot/.../trades?date_from={date_from}&date_to={date_to}
PARSEBOT_TRADES_URL=

# Optional: get_listings. Share counts and listing category, which give company
# size and let the scout skip bonds. Fetched at most once every 30 days.
PARSEBOT_LISTINGS_URL=

# Your parse.bot API key (scraper id 54da6080-f962-4105-8078-791f13c2c88e).
PARSEBOT_API_KEY=

# How the key is sent. Defaults suit a standard "Authorization: Bearer <key>"
# header; change them if parse.bot documents something else, e.g.
# PARSEBOT_AUTH_HEADER=x-api-key with an empty PARSEBOT_AUTH_SCHEME.
PARSEBOT_AUTH_HEADER=Authorization
PARSEBOT_AUTH_SCHEME=Bearer
PARSEBOT_METHOD=GET

# Requests included in your plan per month. The bot refuses to fetch past this.
PARSEBOT_MONTHLY_LIMIT=200

# Credits kept back for the scheduled daily reports. While fewer than this
# remain, interactive commands stop triggering fetches and serve cached data
# instead, so the daily report never loses its budget to a burst of /now.
PARSEBOT_RESERVE=40

# Credits already spent this month outside the bot — set this once so the
# counter starts from reality. With 191 of 200 left, that is 9.
# The counter only ever moves forward, so restarts cannot rewind it, and the
# value is ignored from next month onward.
PARSEBOT_USED_THIS_MONTH=9

# ---------------------------------------------------------------------------
# Scouting — the "what is worth watching" report.
# ---------------------------------------------------------------------------

# Set to false to switch scouting off entirely.
SCOUT_ENABLED=true

# When the scout arrives, in your timezone. Best set after the Uzbek market
# closes. A short scan lands daily; Mondays get a fuller review of the week.
SCOUT_TIME=18:30

# Uzbek business media RSS feeds, comma-separated, used to explain moves.
# Free, no key. A feed that is down is skipped silently.
NEWS_FEEDS=https://uz.kursiv.media/category/investments/feed/,https://uz.kursiv.media/feed/,https://www.gazeta.uz/ru/rss/,https://www.uzdaily.uz/ru/rss

# ---------------------------------------------------------------------------
# Optional settings — sensible defaults, change only if you want to.
# ---------------------------------------------------------------------------

# Comma-separated tickers pre-loaded for a new user on first /start.
DEFAULT_TICKERS=ONTO,CRDO,ALAB,IONQ,QBTS,MANE,NOW

# Default time of the daily report, 24h format, in the user's timezone.
DEFAULT_DIGEST_TIME=09:00

# Default timezone for new users (IANA name, e.g. Europe/Berlin, America/New_York).
DEFAULT_TIMEZONE=UTC

# Index the portfolio is compared against, so the numbers have context.
# SPY = S&P 500, QQQ = Nasdaq 100.
BENCHMARK_TICKER=SPY

# Where the SQLite database file lives. Must be on persistent storage,
# otherwise the watchlist is lost on every restart.
DATABASE_PATH=data/stockbot.db

# Max tickers one user may track (keeps reports short and API usage low).
MAX_TICKERS_PER_USER=25

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Optional. A URL that gets pinged after every successful daily report.
# Use a free https://healthchecks.io check here and you will be notified
# if the bot ever silently stops sending reports.
HEARTBEAT_URL=
